# Local development settings. Copy to server/.env if you need any of these; all are optional.
# On Vercel, set these under Project → Settings → Environment Variables instead.

PORT=3001

# Database: leave unset locally to use the built-in embedded Postgres (stored in server/data/).
# On Vercel this is filled in automatically when you connect Neon.
# DATABASE_URL=postgres://user:pass@host/db

# Email notifications (optional). Without these, notifications still appear in the app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM="Hearth <you@gmail.com>"

# APP_URL=https://your-site.vercel.app   # used for links in emails (auto-detected on Vercel)
# CRON_SECRET=some-long-random-string    # optional: protects the daily repeating-bills job
